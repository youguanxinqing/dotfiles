# font-family = "ZedMono Nerd Font"
font-family = "LXGW WenKai Mono Screen"
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 16
macos-option-as-alt = left
# theme = Everforest Dark Hard

# ghostty 默认 foreground = #ffffff，比它自己调色板里的 white (palette 7 = #c5c8c6)
# 还亮 —— 任何不带颜色的普通输出都被拉到纯白，在 #282c34 背景上刺眼。
# tmux 窗口看着舒服只是因为 .tmux.conf 里 window-style 'fg=colour247' 把它压过了
# (colour247 = #9e9e9e)，herdr 不做这种覆盖，于是默认值原样暴露出来。
# #9e9e9e 就是 colour247 本身，和 tmux 那半边 1:1。One Dark 的 #abb2bf 亮度更高但
# 带 +21 的蓝调（B-R），和 tmux 的中性灰摆一起能看出来色差。
foreground = #9e9e9e

# ghostty 默认 background = #282c34（One Dark），带 +12 的蓝调。
# #1d1f21 = palette 0，即 .tmux.conf 里 window-active-style 'bg=black' 的那个色 ——
# 也就是你在 tmux 里实际盯着的那个 pane 的背景。inactive pane 是 colour236 (#303030)，
# tmux 靠这两个背景的深浅区分焦点；ghostty 只有一个背景，所以取 active 那个。
background = #1d1f21

# herdr 的 PageUp/PageDown 固定翻整页（按 pane 高度，写死的），要半页只能绕道滚轮：
# ESC[<64;col;row M = 上滚一格，65 = 下滚。坐标取 row 999 落在所有 pane 之外，
# herdr 的 wheel handler 就回落到「滚当前焦点 pane」，于是不用管鼠标在哪。
# 8 格 x mouse_scroll_lines(3) = 24 行 ≈ 47 行 pane 的一半，两个值要一起调。
keybind = ctrl+alt+u=text:\x1b[<64;1;999M\x1b[<64;1;999M\x1b[<64;1;999M\x1b[<64;1;999M\x1b[<64;1;999M\x1b[<64;1;999M\x1b[<64;1;999M\x1b[<64;1;999M
keybind = ctrl+alt+d=text:\x1b[<65;1;999M\x1b[<65;1;999M\x1b[<65;1;999M\x1b[<65;1;999M\x1b[<65;1;999M\x1b[<65;1;999M\x1b[<65;1;999M\x1b[<65;1;999M

# 这块键盘没有物理页键，留一对字面量 PageUp/PageDown 给需要真页键的 TUI。
keybind = ctrl+alt+shift+u=csi:5~
keybind = ctrl+alt+shift+d=csi:6~
