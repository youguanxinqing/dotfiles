{
  "title": "Hyper Key Remaps",
  "rules": [
    {
      "description": "Hyper + Control → Caps Lock",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "mandatory": ["command", "control", "option", "shift"], "optional": ["caps_lock"] }
          },
          "to": [
            {
              "key_code": "caps_lock",
              "hold_down_milliseconds": 100
            }
          ]
        }
      ]
    }
  ]
}
