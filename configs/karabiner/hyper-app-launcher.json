{
  "title": "Hyper Key App Launcher",
  "rules": [
    {
      "description": "Hyper + S → Slack",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["command", "control", "option", "shift"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Slack'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + T → Ghostty",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "t",
            "modifiers": {
              "mandatory": ["command", "control", "option", "shift"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Ghostty'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + C → Google Chrome",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["command", "control", "option", "shift"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Google Chrome'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + A → Claude",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": ["command", "control", "option", "shift"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Claude'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + Q → Things 3 Today",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
          },
          "to": [
            {
              "shell_command": "open 'things:///show?id=today'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + W → Things 3 Inbox",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "w",
            "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
          },
          "to": [
            {
              "shell_command": "open 'things:///show?id=inbox'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + B → NeoBoop",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
          },
          "to": [
            {
              "shell_command": "open -a 'NeoBoop'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + Left Option → QuickPrompt Search",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_option",
            "modifiers": { "mandatory": ["command", "control", "option", "shift"] }
          },
          "to": [
            {
              "shell_command": "open -g 'quickprompt://search'"
            }
          ]
        }
      ]
    },
    {
      "description": "Hyper + E → Emacs",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "e",
