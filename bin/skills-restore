#!/usr/bin/env bash
# Restore third-party skills declared in modules/skills/remote.txt.
#
# Three kinds of skill, three owners:
#   - own skills       -> skills/ in this repo, linked by install.sh
#   - third-party      -> remote.txt, installed here with `npx skills`
#   - app-installed    -> the app (rex, herdr, kero, lb-cli, MDComments, ...)
# Only the second kind is this script's job. It installs what is missing from
# ~/.agents/skills and never removes anything; drop a line from remote.txt and
# `npx skills remove -g <name>` to retire one.
set -euo pipefail

self="$0"
[ -L "$self" ] && self="$(readlink "$self")"
ROOT="$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)"
MANIFEST="${SKILLS_MANIFEST:-$ROOT/modules/skills/remote.txt}"
SKILL_ROOT="$HOME/.agents/skills"
LOCK="$HOME/.agents/.skill-lock.json"
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage: skills-restore [-n|--dry-run]   install skills in remote.txt missing from ~/.agents/skills
       skills-restore --save           rewrite remote.txt from ~/.agents/.skill-lock.json

After `npx skills add -g ...` or `npx skills remove -g ...`, run --save and commit remote.txt.
EOF
}

save() {
  local tmp
  tmp="$(mktemp)"
  python3 - "$LOCK" >"$tmp" <<'EOF'
import json, sys
skills = json.load(open(sys.argv[1]))["skills"]
by = {}
for name, s in skills.items():
    # well-known sources (open.feishu.cn) only resolve from their base URL
    by.setdefault(s.get("sourceBaseUrl") or s["source"], []).append(name)
print("# Third-party skills: <source> <skill>...  Generated by `skills-restore --save`.")
for src in sorted(by):
    print(src, *sorted(by[src]))
EOF
  mv "$tmp" "$MANIFEST"
  echo "wrote $MANIFEST"
}

restore() {
  local src names n missing
  command -v npx >/dev/null || { echo "skills-restore: npx not found, skipped" >&2; return 0; }
  [ -f "$MANIFEST" ] || { echo "No manifest: $MANIFEST" >&2; exit 1; }
  while read -r src names; do
    case "$src" in '' | '#'*) continue ;; esac
    missing=""
    for n in $names; do
      [ -e "$SKILL_ROOT/$n" ] || missing="$missing -s $n"
    done
    [ -n "$missing" ] || continue
    # -a codex: Codex's global root is ~/.agents/skills, the shared root; Claude
    # gets its view from skills-mirror, so no other agent dir is written.
    # $missing is unquoted on purpose: it is a list of "-s name" pairs.
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "+ npx -y skills add $src -g -y -a codex$missing"
    else
      # shellcheck disable=SC2086
      npx -y skills add "$src" -g -y -a codex $missing </dev/null ||
        echo "skills-restore: failed to install from $src" >&2
    fi
  done <"$MANIFEST"
}

case "${1:-}" in
  '') restore ;;
  -n | --dry-run) DRY_RUN=1; restore ;;
  --save) save ;;
  -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
