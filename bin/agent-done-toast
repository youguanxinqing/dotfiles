#!/usr/bin/env bash
# 任务完成通知：macOS 使用 Hammerspoon 卡片，Linux 使用桌面系统通知。
# 用法: agent-done-toast <agent> [兜底位置]
#
# 挂着 20+ 个 agent 时光说"完成了"没用，得说清是哪一个。原来的
# tmux 里可以显示 [session:window]；herdr 里对应 workspace 和 tab 的
# label —— env 里只有 id，label 要回查 api snapshot。
#
# 钩子失败会污染 agent 的输出，所以这里一路兜底、始终 exit 0。
set -uo pipefail

here=$(dirname "$(readlink -f "$0")")

agent=${1:-agent}
fallback=${2:-}

herdr="${HERDR_BIN_PATH:-herdr}"
herdr="${herdr% (deleted)}"

where=""
if [[ -n ${HERDR_WORKSPACE_ID:-} ]]; then
  where=$("$herdr" api snapshot 2>/dev/null | jq -r \
    --arg ws "$HERDR_WORKSPACE_ID" --arg tab "${HERDR_TAB_ID:-}" '
      [.result.snapshot.workspaces[] | select(.workspace_id == $ws) | .label] +
      [.result.snapshot.tabs[]       | select(.tab_id == $tab)       | .label]
      | join(" · ")
    ' 2>/dev/null || true)
fi

# 在 herdr 之外跑（或查不到 label）时退回 tmux 上下文和调用方给的位置。
if [[ -z $where && -n ${TMUX:-} ]] && command -v tmux >/dev/null 2>&1; then
  tmux_context=$(tmux display-message -p '[#S:#W] ' 2>/dev/null || true)
  where="$tmux_context$fallback"
fi
[[ -n $where ]] || where=$fallback
: "${where:=unknown}"

"$here/g-notify" --title "任务完成" --message "$where" --agent "$agent" \
  >/dev/null 2>&1 || true
exit 0
