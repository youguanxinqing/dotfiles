#!/usr/bin/env bash
# Jump to the next agent that is blocked or done. Bound to prefix+u in herdr/config.toml.
# Repeated presses cycle through them; blocked ranks before done. Agents that are
# working or idle are never jumped to — with ~10 agents open, most are working.
# Nothing to jump to: focus stays put, and a toast reports the current status mix.
#
# ponytail: 一个 jq 管道而不是装插件。martin-ro/herdr-next-agent 做的是同一件事，
# 但它的 platforms 漏了 macos、agent focus 还传错 id（terminal_id，herdr 0.8 只认 pane_id）。
# 内建的 next_agent 键也不行：它会把 working/idle 的一起轮进来。
set -euo pipefail

# HERDR_BIN_PATH 在 herdr 原地升级后会带 " (deleted)" 后缀。
herdr="${HERDR_BIN_PATH:-herdr}"
herdr="${herdr% (deleted)}"

# Hammerspoon 的浮层样式可控、且不管你当前在哪个 app 都看得到（herdr 内浮层只画在
# 终端里，系统通知又长得跟主题不搭）。它没跑或 ipc 没加载就退回 herdr 的系统通知。
# -t 1 是必需的：不带超时且 Hammerspoon 没启动时，hs 会停在「要不要帮你启动」的确认上。
notify() {
  # ] 会提前闭合 Lua 的 [[...]]，把后面的文案变成代码。删掉。
  local title=${1//]/} body=${2//]/}
  if pgrep -x Hammerspoon >/dev/null &&
    [[ $(hs -t 1 -q -c "herdrToast({title=[[$title]], body=[[$body]]})" 2>/dev/null) == ok ]]; then
    return
  fi
  "$herdr" notification show "$title" --body "$body" --sound none >/dev/null
}

agents=$("$herdr" agent list)

target=$(jq -r '
  ([.result.agents[] | select(.agent_status == "blocked" or .agent_status == "done")]
   | sort_by(.agent_status != "blocked", .pane_id)) as $ranked
  | ($ranked | map(.focused) | index(true)) as $at
  | if ($ranked | length) == 0 then empty
    else $ranked[if $at == null then 0 else ($at + 1) % ($ranked | length) end].pane_id
    end
' <<<"$agents")

if [[ -z $target ]]; then
  mix=$(jq -r '
    [.result.agents[].agent_status] | sort | group_by(.)
    | map("\(length) \(.[0])") | join(" · ")
  ' <<<"$agents")
  notify "没有 agent 在等你" "${mix:-一个 agent 都没有}"
  exit 0
fi

"$herdr" agent focus "$target" >/dev/null
