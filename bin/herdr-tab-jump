#!/usr/bin/env bash
# Fuzzy-jump to any herdr tab. Bound to prefix+f in configs/herdr/config.toml.
# ponytail: 建的是 fzf 管道而不是装插件 —— 内建 prefix+1..9 够不到编号 >= 10 的 tab，
# 这就是唯一的缺口。想要连 agent/repo/branch 一起搜再换 jeffarese/herdr-bar。
set -euo pipefail

# Herdr may have been started outside fish (for example by a GUI terminal), so
# popup helpers must not depend on fish having initialized PATH first.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

out=$({ herdr workspace list; herdr tab list; })

# ponytail: server/CLI protocol 不匹配等错误会返回 error JSON，静默过 jq 就是空列表 —— 直接把错误亮出来
err=$(jq -rs '[.[].error.message // empty] | first // empty' <<<"$out")
if [ -n "$err" ]; then
  printf '%s\n' "$err"
  read -rsn1
  exit 1
fi

# 屏幕上从上往下读：workspace 名升序、tab 编号降序；workspace_id 兜底，免得同名 workspace 的 tab 交错。
# fzf 默认布局把第一行放在最底下贴着 prompt、光标也停在那，所以喂进去之前整体 reverse。
# --no-sort: 否则输入后同分项按行长排，idle 比 working 短，会跑到前面。
sel=$(jq -rs '(.[0].result.workspaces | map({(.workspace_id): .label}) | add) as $ws
      | .[1].result.tabs
      | map(.ws = ($ws[.workspace_id] // .workspace_id))
      | sort_by((.ws | ascii_downcase), .workspace_id, -.number) | reverse[]
      | [.tab_id, (if .focused then "*" else " " end) + (.number|tostring),
         .ws, .label, .agent_status] | @tsv' <<<"$out" \
  | column -t -s "$(printf '\t')" \
  | fzf --prompt='tab> ' --header='enter 聚焦 / esc 取消' --no-multi --no-sort) || exit 0

herdr tab focus "${sel%% *}"
