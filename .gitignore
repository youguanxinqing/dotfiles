fish/local.d/
fish/conf.d/variables/proxy.fish
!fish/conf.d/variables/proxy.fish.template

config/private_remote/

# herdr runtime state: logs, sockets, session/release cache
herdr/*.log
herdr/*.sock
herdr/session.json
# 多 session 布局下每个 session 一个目录，内容同上：日志、socket、session.json
herdr/sessions/
herdr/release-notes.json
herdr/.plugins.lock
herdr/plugins.json
herdr/plugins/github/
# 插件目录里只跟踪配置文件，其余都是插件自己写的运行时状态
herdr/plugins/config/*/*
!herdr/plugins/config/*/config.toml
!herdr/plugins/config/*/settings.json
!herdr/plugins/config/*/allowlist.txt

.DS_Store

# Claude Code 的本机 permission 白名单。~/.config/git/ignore 里已经有一条全局规则，
# 但那是机器上的、不随仓库走 —— 新机器上克隆完就没人拦了，而这个文件里会出现
# 公司项目路径，仓库是公开的。所以在仓库里再挡一次。
**/.claude/settings.local.json

sync-note.sh
sync-note.log

clash-verge-recv/
clash-verge-rev/

__pycache__/
